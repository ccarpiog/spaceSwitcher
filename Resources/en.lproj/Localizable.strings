/* Title of a normal Mission Control desktop; %d is its number on that display. */
"space.desktop.number" = "Desktop %d";

/* Shown in place of the app list for a Space that has no windows on it. */
"space.empty" = "empty";

/* Small marker on the Space that is currently on screen. */
"space.current" = "current";

/* Fallback heading for a display whose name could not be resolved. */
"display.unknown" = "Unknown display";

/* Hint bar: the arrow keys move the highlight. */
"hud.hint.select" = "select";

/* Hint bar: Return jumps to the highlighted Space. */
"hud.hint.jump" = "jump";

/* Hint bar: Escape closes the panel without jumping. */
"hud.hint.cancel" = "close";

/* Hint bar: Q quits the app. There is no dock icon or menu bar item, so this is
   the only way out. */
"hud.hint.quit" = "quit";

/* Tooltip and accessibility label of the gear button in the corner of the panel. */
"hud.settings" = "Open settings";

/* Title of the Settings window. */
"settings.title" = "spaceSwitcher settings";

/* Name of the tab holding the settings that affect the whole app. */
"settings.tab.general" = "General";

/* Name of the tab listing every Space so it can be given a name. */
"settings.tab.spaces" = "Spaces";

/* Note at the top of the Spaces tab, explaining what the name fields are for. */
"settings.spaces.detail" = "Name a Space and the panel shows that name instead of the one macOS implies. Empty the field to go back to it. The apps listed under each Space are there to help you tell one bare desktop from another.";

/* Shown in place of a name field for a fullscreen Space. Those are named after
   the app filling them and are rebuilt from scratch every time, so a name given
   to one would stop applying without warning. */
"settings.spaces.fullscreen" = "Named after its app";

/* Shown in place of a name field for a Space macOS reports without an identifier
   of its own, which leaves nowhere to file a name. */
"settings.spaces.unnameable" = "Cannot be named";

/* Tooltip on that message, explaining why. */
"settings.spaces.unnameable.help" = "macOS reports no identifier for this Space, so a name given to it could not be found again next time.";

/* Shown in the Spaces tab when the layout came back with no Spaces in it at all. */
"settings.spaces.empty" = "No Spaces could be read just now. Open Mission Control once, then come back.";

/* Label of the row holding the global shortcut recorder. */
"settings.general.hotKey" = "Global shortcut";

/* Note under the shortcut recorder, explaining how to change it. */
"settings.general.hotKey.detail" = "Press this shortcut from any app to open the Spaces panel. Click the shortcut and type the combination you want; press Escape to cancel.";

/* Shown on the recorder button while it waits for the key press. */
"settings.general.hotKey.recording" = "Type the new shortcut…";

/* Tooltip on the recorder button. */
"settings.general.hotKey.help" = "Click, then type the combination you want. Escape cancels.";

/* Button that puts the original shortcut back. */
"settings.general.hotKey.reset" = "Restore default";

/* Shown when the recorded combination has no modifier key. Refused because a
   shortcut without modifiers takes that key over in every application. */
"settings.general.hotKey.error.noModifier" = "Add at least one modifier (⌘, ⌃, ⌥ or ⇧): a shortcut without modifiers would take that key over in every app.";

/* Shown when macOS refused the new combination and the previous shortcut is still
   working. %1$@ is the refused combination, %2$@ the one still in use. The cause
   is deliberately hedged: macOS reports a refusal, never a reason. */
"settings.general.hotKey.error.taken" = "macOS did not accept %1$@, so spaceSwitcher is still using %2$@. Another app may already have that combination.";

/* Shown at launch when the stored shortcut was refused and the default one is
   standing in for it. %1$@ is the stored combination, %2$@ the default. */
"settings.general.hotKey.error.usingFallback" = "macOS did not accept %1$@ when the app started, so spaceSwitcher is using %2$@ for now. Your combination has been kept and will be tried again next time the app starts.";

/* Shown when the combination was refused and no working shortcut is left at all,
   so the menu bar icon has been turned on to keep the app reachable. %1$@ is the
   combination that was refused. */
"settings.general.hotKey.error.unavailable" = "macOS did not accept %1$@, and no other shortcut could be registered either, so spaceSwitcher has none right now. The menu bar icon has been turned on for this session so these settings stay within reach; choose another combination.";

/* Shown when macOS refused to release the shortcut in force, so it cannot be
   replaced for the moment. %1$@ is that combination. */
"settings.general.hotKey.error.notReleased" = "macOS would not release %1$@, so it is still in use and cannot be replaced right now. Try again in a moment.";

/* Shown when the keyboard could not be read, so recording never started. */
"settings.general.hotKey.error.recorderUnavailable" = "The keyboard could not be read, so the shortcut cannot be recorded right now. Try again in a moment.";

/* Shown when the app's own keyboard handler could not be installed, which leaves
   no global shortcut possible at all. */
"settings.general.hotKey.error.dispatchUnavailable" = "spaceSwitcher could not install its keyboard handler, so the global shortcut cannot work. The menu bar icon has been turned on for this session; quitting and opening the app again usually fixes this.";

/* Label of the toggle that starts the app when the user logs in. */
"settings.general.login" = "Open at login";

/* Note under that toggle. */
"settings.general.login.detail" = "spaceSwitcher starts on its own when you log in. It has no dock icon — it just waits for the shortcut.";

/* Shown when macOS holds the login item but is waiting for the user to approve it. */
"settings.general.login.requiresApproval" = "macOS is waiting for you to approve this login item. Turn it on in System Settings › General › Login items.";

/* Shown when macOS does not recognise this copy of the app as a login item, which
   normally means it is being run from somewhere it was not installed. */
"settings.general.login.notFound" = "macOS cannot find this copy of spaceSwitcher as a login item. Move the app to the Applications folder and try again.";

/* Shown when registering or unregistering the login item failed; %@ is the
   system's description of the error. */
"settings.general.login.failed" = "The login item could not be changed: %@";

/* Button that opens the login items list in System Settings. */
"settings.general.login.openSystemSettings" = "Open login items";

/* Label of the toggle that shows or hides the menu bar icon. */
"settings.general.menuBarIcon" = "Show icon in the menu bar";

/* Note under that toggle. Worth stating explicitly: the menu bar icon is where
   the Quit command lives. */
"settings.general.menuBarIcon.detail" = "The menu bar icon opens the Spaces panel and these settings, and is where you quit spaceSwitcher.";

/* Accessibility description of the menu bar icon itself. */
"menu.icon.description" = "spaceSwitcher";

/* Menu bar entry that brings the Spaces panel up. */
"menu.showPanel" = "Show Spaces";

/* Menu bar entry that opens the Settings window. */
"menu.settings" = "Settings…";

/* Menu bar entry that quits the app. */
"menu.quit" = "Quit spaceSwitcher";

/* Shown in the panel when the private SkyLight symbols could not be resolved,
   which means this macOS release changed them. */
"error.unsupported" = "This version of macOS does not expose the Spaces information spaceSwitcher needs. The app will need updating.";

/* Warning banner shown above the Space list when Automation permission has been
   refused. Only shown for an outright refusal: if permission has simply never been
   requested, the prompt appears on the first jump and no warning is needed. */
"error.automation" = "spaceSwitcher is not allowed to control System Events, so it cannot switch Spaces. Allow it under Privacy & Security › Automation.";

/* Warning banner shown above the Space list when the panel has been brought back
   after a jump that did not go through, for any reason other than permission. The
   panel is hidden before the switch starts, so without this the failure would leave
   nothing on screen and nothing said. */
"error.jumpFailed" = "That jump did not go through. The Spaces below have just been read again, so pick one and try once more.";

/* Title of the alert shown after a jump failed for lack of permission. */
"alert.automation.title" = "Permission needed to switch Spaces";

/* Body of that alert. */
"alert.automation.body" = "spaceSwitcher switches Spaces by asking System Events to press the Mission Control shortcut. Allow it under Privacy & Security › Automation, then try again.";

/* Button that opens the relevant System Settings pane. */
"alert.openSettings" = "Open System Settings";

/* Button that dismisses the alert. */
"alert.cancel" = "Cancel";
