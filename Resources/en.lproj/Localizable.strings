/* Title of a normal Mission Control desktop; %d is its number on that display. */
"space.desktop.number" = "Desktop %d";

/* Shown in place of the app list for a Space that has no windows on it. */
"space.empty" = "empty";

/* Small marker on the Space that is currently on screen. */
"space.current" = "current";

/* Fallback heading for a display whose name could not be resolved. */
"display.unknown" = "Unknown display";

/* Hint bar: the arrow keys move the highlight. */
"hud.hint.select" = "select";

/* Hint bar: Return jumps to the highlighted Space. */
"hud.hint.jump" = "jump";

/* Hint bar: Escape closes the panel without jumping. */
"hud.hint.cancel" = "close";

/* Hint bar: Q quits the app. There is no dock icon or menu bar item, so this is
   the only way out. */
"hud.hint.quit" = "quit";

/* Shown in the panel when the private SkyLight symbols could not be resolved,
   which means this macOS release changed them. */
"error.unsupported" = "This version of macOS does not expose the Spaces information spaceSwitcher needs. The app will need updating.";

/* Warning banner shown above the Space list when Automation permission has been
   refused. Only shown for an outright refusal: if permission has simply never been
   requested, the prompt appears on the first jump and no warning is needed. */
"error.automation" = "spaceSwitcher is not allowed to control System Events, so it cannot switch Spaces. Allow it under Privacy & Security › Automation.";

/* Title of the alert shown after a jump failed for lack of permission. */
"alert.automation.title" = "Permission needed to switch Spaces";

/* Body of that alert. */
"alert.automation.body" = "spaceSwitcher switches Spaces by asking System Events to press the Mission Control shortcut. Allow it under Privacy & Security › Automation, then try again.";

/* Button that opens the relevant System Settings pane. */
"alert.openSettings" = "Open System Settings";

/* Button that dismisses the alert. */
"alert.cancel" = "Cancel";
