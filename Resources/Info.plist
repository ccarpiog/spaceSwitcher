	<!-- No dock icon and no menu bar: the global hotkey is the entire interface. -->
	<key>LSUIElement</key>
	<true/>
	<!-- Required: the jump is performed by driving System Events, because every
	     direct route to switching Spaces either fails silently or corrupts the
	     compositor. See CLAUDE.md. -->
	<key>NSAppleEventsUsageDescription</key>
	<string>spaceSwitcher asks System Events to press the Mission Control shortcut that moves between Spaces. This is the only reliable way to switch Spaces on macOS.</string>
