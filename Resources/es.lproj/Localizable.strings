/* Title of a normal Mission Control desktop; %d is its number on that display. */
"space.desktop.number" = "Escritorio %d";

/* Shown in place of the app list for a Space that has no windows on it. */
"space.empty" = "vacío";

/* Small marker on the Space that is currently on screen. */
"space.current" = "actual";

/* Fallback heading for a display whose name could not be resolved. */
"display.unknown" = "Pantalla desconocida";

/* Hint bar: the arrow keys move the highlight. */
"hud.hint.select" = "seleccionar";

/* Hint bar: Return jumps to the highlighted Space. */
"hud.hint.jump" = "ir";

/* Hint bar: Escape closes the panel without jumping. */
"hud.hint.cancel" = "cerrar";

/* Hint bar: Q quits the app. There is no dock icon or menu bar item, so this is
   the only way out. */
"hud.hint.quit" = "salir";

/* Tooltip and accessibility label of the gear button in the corner of the panel. */
"hud.settings" = "Abrir los ajustes";

/* Title of the Settings window. */
"settings.title" = "Ajustes de spaceSwitcher";

/* Name of the tab holding the settings that affect the whole app. */
"settings.tab.general" = "General";

/* Name of the tab listing every Space so it can be given a name. */
"settings.tab.spaces" = "Espacios";

/* Note at the top of the Spaces tab, explaining what the name fields are for. */
"settings.spaces.detail" = "Ponle nombre a un espacio y el panel mostrará ese nombre en lugar del que da macOS. Vacía el campo para volver a él. Las apps que aparecen debajo de cada espacio están ahí para ayudarte a distinguir un escritorio vacío de otro.";

/* Shown in place of a name field for a fullscreen Space. Those are named after
   the app filling them and are rebuilt from scratch every time, so a name given
   to one would stop applying without warning. */
"settings.spaces.fullscreen" = "Toma el nombre de su app";

/* Shown in place of a name field for a Space macOS reports without an identifier
   of its own, which leaves nowhere to file a name. */
"settings.spaces.unnameable" = "No se le puede poner nombre";

/* Tooltip on that message, explaining why. */
"settings.spaces.unnameable.help" = "macOS no da ningún identificador para este espacio, así que un nombre no se volvería a encontrar la próxima vez.";

/* Shown in the Spaces tab when the layout came back with no Spaces in it at all. */
"settings.spaces.empty" = "Ahora mismo no se ha podido leer ningún espacio. Abre Mission Control una vez y vuelve aquí.";

/* Label of the row holding the global shortcut recorder. */
"settings.general.hotKey" = "Atajo global";

/* Note under the shortcut recorder, explaining how to change it. */
"settings.general.hotKey.detail" = "Pulsa este atajo desde cualquier app para abrir el panel de espacios. Haz clic en el atajo y pulsa la combinación que quieras; con Escape se cancela.";

/* Shown on the recorder button while it waits for the key press. */
"settings.general.hotKey.recording" = "Pulsa el atajo nuevo…";

/* Tooltip on the recorder button. */
"settings.general.hotKey.help" = "Haz clic y pulsa la combinación que quieras. Escape cancela.";

/* Button that puts the original shortcut back. */
"settings.general.hotKey.reset" = "Restaurar el predeterminado";

/* Shown when the recorded combination has no modifier key. Refused because a
   shortcut without modifiers takes that key over in every application. */
"settings.general.hotKey.error.noModifier" = "Añade al menos un modificador (⌘, ⌃, ⌥ o ⇧): un atajo sin modificadores se quedaría con esa tecla en todas las apps.";

/* Shown when macOS refused the new combination and the previous shortcut is still
   working. %1$@ is the refused combination, %2$@ the one still in use. The cause
   is deliberately hedged: macOS reports a refusal, never a reason. */
"settings.general.hotKey.error.taken" = "macOS no ha aceptado %1$@, así que spaceSwitcher sigue usando %2$@. Puede que otra app ya tenga esa combinación.";

/* Shown at launch when the stored shortcut was refused and the default one is
   standing in for it. %1$@ is the stored combination, %2$@ the default. */
"settings.general.hotKey.error.usingFallback" = "macOS no ha aceptado %1$@ al abrirse la app, así que spaceSwitcher está usando %2$@ por ahora. Tu combinación se ha conservado y se volverá a intentar la próxima vez que se abra la app.";

/* Shown when the combination was refused and no working shortcut is left at all,
   so the menu bar icon has been turned on to keep the app reachable. %1$@ is the
   combination that was refused. */
"settings.general.hotKey.error.unavailable" = "macOS no ha aceptado %1$@ y tampoco se ha podido registrar ningún otro atajo, así que spaceSwitcher se ha quedado sin ninguno. Se ha activado el icono de la barra de menús durante esta sesión para que estos ajustes sigan a mano; elige otra combinación.";

/* Shown when macOS refused to release the shortcut in force, so it cannot be
   replaced for the moment. %1$@ is that combination. */
"settings.general.hotKey.error.notReleased" = "macOS no ha liberado %1$@, así que sigue en uso y ahora mismo no se puede sustituir. Vuelve a intentarlo dentro de un momento.";

/* Shown when the keyboard could not be read, so recording never started. */
"settings.general.hotKey.error.recorderUnavailable" = "No se ha podido leer el teclado, así que ahora mismo no se puede grabar el atajo. Vuelve a intentarlo dentro de un momento.";

/* Shown when the app's own keyboard handler could not be installed, which leaves
   no global shortcut possible at all. */
"settings.general.hotKey.error.dispatchUnavailable" = "spaceSwitcher no ha podido instalar su gestor de teclado, así que el atajo global no puede funcionar. Se ha activado el icono de la barra de menús durante esta sesión; salir de la app y volver a abrirla suele arreglarlo.";

/* Label of the toggle that starts the app when the user logs in. */
"settings.general.login" = "Abrir al iniciar sesión";

/* Note under that toggle. */
"settings.general.login.detail" = "spaceSwitcher se abre solo al iniciar sesión. No tiene icono en el Dock: se queda esperando el atajo.";

/* Shown when macOS holds the login item but is waiting for the user to approve it. */
"settings.general.login.requiresApproval" = "macOS está esperando a que apruebes este ítem de inicio. Actívalo en Ajustes del Sistema › General › Ítems de inicio.";

/* Shown when macOS does not recognise this copy of the app as a login item, which
   normally means it is being run from somewhere it was not installed. */
"settings.general.login.notFound" = "macOS no encuentra esta copia de spaceSwitcher como ítem de inicio. Mueve la app a la carpeta Aplicaciones y vuelve a intentarlo.";

/* Shown when registering or unregistering the login item failed; %@ is the
   system's description of the error. */
"settings.general.login.failed" = "No se ha podido cambiar el ítem de inicio: %@";

/* Button that opens the login items list in System Settings. */
"settings.general.login.openSystemSettings" = "Abrir los ítems de inicio";

/* Label of the toggle that shows or hides the menu bar icon. */
"settings.general.menuBarIcon" = "Mostrar el icono en la barra de menús";

/* Note under that toggle. Worth stating explicitly: the menu bar icon is where
   the Quit command lives. */
"settings.general.menuBarIcon.detail" = "El icono de la barra de menús abre el panel de espacios y estos ajustes, y es desde donde se sale de spaceSwitcher.";

/* Accessibility description of the menu bar icon itself. */
"menu.icon.description" = "spaceSwitcher";

/* Menu bar entry that brings the Spaces panel up. */
"menu.showPanel" = "Mostrar los espacios";

/* Menu bar entry that opens the Settings window. */
"menu.settings" = "Ajustes…";

/* Menu bar entry that quits the app. */
"menu.quit" = "Salir de spaceSwitcher";

/* Shown in the panel when the private SkyLight symbols could not be resolved,
   which means this macOS release changed them. */
"error.unsupported" = "Esta versión de macOS no expone la información de espacios que spaceSwitcher necesita. Habrá que actualizar la app.";

/* Warning banner shown above the Space list when Automation permission has been
   refused. Only shown for an outright refusal: if permission has simply never been
   requested, the prompt appears on the first jump and no warning is needed. */
"error.automation" = "spaceSwitcher no tiene permiso para controlar System Events, así que no puede cambiar de espacio. Concédelo en Privacidad y seguridad › Automatización.";

/* Title of the alert shown after a jump failed for lack of permission. */
"alert.automation.title" = "Se necesita permiso para cambiar de espacio";

/* Body of that alert. */
"alert.automation.body" = "spaceSwitcher cambia de espacio pidiendo a System Events que pulse el atajo de Mission Control. Concede el permiso en Privacidad y seguridad › Automatización y vuelve a intentarlo.";

/* Button that opens the relevant System Settings pane. */
"alert.openSettings" = "Abrir Ajustes del Sistema";

/* Button that dismisses the alert. */
"alert.cancel" = "Cancelar";
